{
  "name": "@al-riwayah/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@al-riwayah/content": "workspace:*",
    "@al-riwayah/game-engine": "workspace:*",
    "@al-riwayah/protocol": "workspace:*",
    "@fastify/cors": "^11.0.0",
    "fastify": "^5.10.0",
    "socket.io": "^4.8.0",
    "tsx": "^4.23.0",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "socket.io-client": "^4.8.0",
    "typescript": "~5.9.3"
  }
}
